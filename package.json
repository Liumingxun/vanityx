{
  "name": "@vanityx/core",
  "version": "2.0.0",
  "description": "A TypeScript library for searching Ethereum CREATE2 vanity addresses.",
  "keywords": [
    "create2",
    "createx",
    "ethereum",
    "vanity",
    "wasm"
  ],
  "license": "MPL-2.0",
  "author": "lime <liumingxun@yeah.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liumingxun/vanityx-next.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "prepare": "vp config",
    "build": "vp run pack",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "rolldown-plugin-wasm": "^0.3.2",
    "typescript": "^7.0.2",
    "viem": "^2.57.16",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  }
}
